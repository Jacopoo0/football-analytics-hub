# Football Analytics Hub — Configuration
# Copy this file to .env and set your Groq API key.
# Get a free key at: https://console.groq.com/keys
#
# AI features (narrative reports) require GROQ_API_KEY.
# Without it, the dashboard works in data-only mode with tables
# and statistics.

GROQ_API_KEY=gsk_your_groq_api_key_here
